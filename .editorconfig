# EditorConfig configuration for SessionIntent
# https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = 100
trim_trailing_whitespace = true

[*.py]
indent_size = 4
indent_style = space
max_line_length = 88

[*.yaml]
indent_size = 2
indent_style = space
max_line_length = 120

[*.toml]
indent_size = 2
indent_style = space

[*.sh]
indent_size = 4
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[Makefile]
indent_style = tab
